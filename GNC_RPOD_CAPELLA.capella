              source="#5a54e088-0dda-4935-a14d-869925bdd89d" target="#afbd9957-017f-4716-bee8-c5448ff6bc6a"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="874a204a-e2cb-4857-a6d7-8778e47dddfe"
            ReqIFLongName="The GNC system shall monitor the integrity of the navigation solution during RPOD operations.">
