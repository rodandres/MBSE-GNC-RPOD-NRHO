        <ownedRequirements xsi:type="Requirements:Requirement" id="83a192dc-1619-4550-926a-9de92649e4a5"
            ReqIFLongName="The GNC system shall synchronize navigation sensor data according to their associated measurement timestamps before sensor fusion.">
