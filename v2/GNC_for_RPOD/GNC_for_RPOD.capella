                name="Command &amp; Data Handling Officer (C&amp;DH)" abstractType="#d6792af0-876b-4cbb-968c-53cd92873792"/>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="b1e7f167-18dc-4909-8092-dd6f55ed6cc4"
                name="Flight Dynamics Officer (FDO)" abstractType="#2bde9002-7694-422d-ab8f-e0c1fe2fd9b7"/>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="8617b79b-2377-406b-93d0-e43879dfb068"
                name="Integrated Communications Officer (INCO)" abstractType="#5ad6478f-360a-4df9-acb8-560f9015b9ad"/>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="e7aa4a3b-b166-4d2e-a31b-e6fe852c7b74"
                name="Mechanical &amp; Power Officer (MPO)" abstractType="#c5044361-1be9-4231-ac0a-f49c64d8d68e"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="b65c9873-ca7b-43f2-9e70-bde14a7757c7"
                name="Guidance, Navifation &amp; Control Systems Officer (GNC)" summary=""
                description="&lt;p>The GNC monitors all vehicle guidance, navigation, and control systems. Also responsible for propulsion systems such as the service propulsion system and reaction control system (RCS).&lt;/p>&#xA;"
                actor="true" human="true"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="ac02bb72-81f9-48e0-9a10-999d0f96f0bb"
                name="Flight Director (Flight)" summary="" description="&lt;p>&amp;nbsp;The team leader who holds final authority over all real-time operational decisions, risk management, and vehicle safety.&lt;/p>&#xA;"
                actor="true" human="true"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="ecd6e4ea-51ec-4400-a299-27885e9f1a14"
                name="Visiting Vehicle Officer ( VVO)" summary="" description="&lt;p>Coordinates traffic, docking, and undocking for incoming vehicles to the Target Vehicle.&lt;/p>&#xA;"
                actor="true" human="true"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="d6792af0-876b-4cbb-968c-53cd92873792"
                name="Command &amp; Data Handling Officer (C&amp;DH)" summary="" description="&lt;p>Monitors the avionics and computer systems.&lt;/p>&#xA;"
                actor="true" human="true"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="2bde9002-7694-422d-ab8f-e0c1fe2fd9b7"
                name="Flight Dynamics Officer (FDO)" summary="" description="&lt;p>&amp;nbsp;Plans and monitors the spacecraft&amp;#39;s orbital path, rendezvous maneuvers, and re-entry trajectories.&lt;/p>&#xA;"
                actor="true" human="true"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="5ad6478f-360a-4df9-acb8-560f9015b9ad"
                name="Integrated Communications Officer (INCO)" summary="" description="&lt;p>Monitors all of Visiting Vehicle&amp;rsquo;s communications systems.&lt;/p>&#xA;"
                actor="true" human="true"/>
            <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="c5044361-1be9-4231-ac0a-f49c64d8d68e"
                name="Mechanical &amp; Power Officer (MPO)" summary="" description="&lt;p>Is responsible for electrical, mechanical, structural, and landing and recovery systems.&lt;/p>&#xA;"
                actor="true" human="true"/>
          </ownedEntities>
