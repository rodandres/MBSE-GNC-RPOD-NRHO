              id="95fe2da3-d906-4ed0-aa8d-60d30db112b9" included="#f4a99079-3357-46eb-8394-d1679b5a743a"/>
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="71395654-33b7-4d07-bbae-52b63797b5f2" involved="#81ccb9c9-6259-40bd-b1aa-219b622f1588"/>
        </ownedOperationalCapabilities>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="3515e9ae-f39e-4a0e-b9b4-9ea7f6cfc3b6" name="Conduct Rendezvous Operations"
            description="&lt;p>Ability to approach the Target Vehicle from an initial separation distance and progressively reduce the relative distance while maintaining safe flight conditions.&lt;/p>&#xA;">
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="60989a4c-4893-4740-922b-9097724094bd" included="#32ba650b-a244-4f52-a0f8-265d7b6b624b"/>
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="52319da8-27db-4eb9-bdc5-1400403cf67c" included="#cd542894-2673-4884-bcfe-9394409d1a3d"/>
        </ownedOperationalCapabilities>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="32ba650b-a244-4f52-a0f8-265d7b6b624b" name="Perform Far-Range Rendezvous"
            description="&lt;p>Ability to execute the initial approach toward the Target Vehicle, reducing the separation distance from the rendezvous initiation point to the proximity operations region.&lt;/p>&#xA;"/>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="cd542894-2673-4884-bcfe-9394409d1a3d" name="Perform Close-Range Rendezvous"
            description="&lt;p>Ability to perform controlled close-range approach maneuvers while maintaining acceptable relative position, velocity, and vehicle safety constraints.&lt;/p>&#xA;"/>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="e746fc2e-642d-418d-80a1-c39e729923e3" name="Conduct Proximity Operations"
            description="&lt;p>Ability to perform controlled operations in the vicinity of the Target Vehicle while maintaining relative navigation, trajectory control, and passive safety constraints.&lt;/p>&#xA;">
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="a513cef9-22d6-4f9b-9e3c-b9689378a16a" included="#352254c4-d28a-4b53-928c-bc7ca7d8617c"/>
