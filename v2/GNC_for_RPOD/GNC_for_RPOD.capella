            id="32ba650b-a244-4f52-a0f8-265d7b6b624b" name="Perform Far-Range Rendezvous"
            description="&lt;p>Ability to execute the initial approach toward the Target Vehicle, reducing the separation distance from the rendezvous initiation point to the proximity operations region.&lt;/p>&#xA;"/>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="cd542894-2673-4884-bcfe-9394409d1a3d" name="Perform Close-Range Rendezvous"
            description="&lt;p>Ability to perform controlled close-range approach maneuvers while maintaining acceptable relative position, velocity, and vehicle safety constraints.&lt;/p>&#xA;"/>
