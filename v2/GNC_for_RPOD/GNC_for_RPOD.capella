        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="2a13beda-dc16-4be6-b649-06466a8acd9b" name="Conduct Cislunar RPOD Mission"
            description="&lt;p>Ability to conduct the complete rendezvous, proximity operations, and docking mission between the Visiting Vehicle and the Target Vehicle in the cislunar environment.&lt;/p>&#xA;">
          <extends xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityExtend"
              id="1e7ae620-b153-488e-9179-e8c5308876f3" extended="#2410ad10-a951-40cf-9892-0df50e23653b"/>
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="1396b963-f206-4139-9995-97aa635ffc13" included="#3515e9ae-f39e-4a0e-b9b4-9ea7f6cfc3b6"/>
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="04686e3d-1043-42d5-846e-990da7e21286" included="#e746fc2e-642d-418d-80a1-c39e729923e3"/>
