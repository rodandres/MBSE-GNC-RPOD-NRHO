        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="3515e9ae-f39e-4a0e-b9b4-9ea7f6cfc3b6" name="Conduct Rendezvous Operations"
            description="&lt;p>Ability to approach the Target Vehicle from an initial separation distance and progressively reduce the relative distance while maintaining safe flight conditions.&lt;/p>&#xA;">
          <includes xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityInclude"
              id="60989a4c-4893-4740-922b-9097724094bd" included="#32ba650b-a244-4f52-a0f8-265d7b6b624b"/>
