        <ownedCapabilities xsi:type="org.polarsys.capella.core.data.ctx:Capability"
            id="6985afd4-ba8b-4428-a7f0-4d2c39321cc6" name="Perform Far-Range Rendezvous"
            description="&lt;p>Ability to execute the initial approach toward the Target Vehicle, reducing the separation distance from the rendezvous initiation point to the proximity operations region.&lt;/p>&#xA;">
          <ownedAbstractCapabilityRealizations xsi:type="org.polarsys.capella.core.data.interaction:AbstractCapabilityRealization"
              id="ed44f641-0b87-4471-943d-17082419b5a9" targetElement="#32ba650b-a244-4f52-a0f8-265d7b6b624b"
