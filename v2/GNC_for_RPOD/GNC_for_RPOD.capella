  <ownedModelRoots xsi:type="org.polarsys.capella.core.data.capellamodeller:SystemEngineering"
      id="0726407b-bb73-4c28-98b3-e880c09334be" name="GNC_for_RPOD">
    <ownedArchitectures xsi:type="org.polarsys.capella.core.data.oa:OperationalAnalysis"
        id="c5a3e878-b117-4f32-8226-b4b63cbb5e0f" name="Operational Analysis">
      <ownedExtensions xsi:type="CapellaRequirements:CapellaModule" id="e2997f3f-fc21-4cec-bfc1-4429dc15442b"
          ReqIFLongName="Operational Needs">
        <ownedRequirements xsi:type="Requirements:Requirement" id="1daae4b4-ece5-45a6-bab0-0ae844ec7ad7"
            ReqIFLongName="Overall RPOD Operational Safety" ReqIFName="OA-N-01" ReqIFText="&lt;p>Mission Control needs the Visiting Vehicle to maintain a safe operational condition throughout RPOD operations, from Rendezvous Start until docking completion, preventing loss of vehicle control, unintended contact with the Target Spacecraft, and other hazardous interactions.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="3dc452d5-4a24-442b-b5e5-7d14e28a0473"
            ReqIFLongName="Trajectory and Approach Constraint Compliance" ReqIFName="OA-N-02"
            ReqIFText="&lt;p>Mission Control needs the Visiting Vehicle&amp;#39;s trajectory and approach behavior to remain within the operational and safety constraints applicable to each RPOD phase, including the Keep-Out Sphere and designated approach corridors, unless an authorized operational exception applies.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="b0a435ea-464e-4547-b7c3-cfc7778021a1"
            ReqIFLongName="Navigation State Knowledge and Integrity" ReqIFName="OA-N-03"
            ReqIFText="&lt;p>Mission Control needs reliable knowledge of the Visiting Vehicle&amp;#39;s absolute position, velocity and attitude, as well as its relative position, velocity and attitude with respect to the Target Spacecraft, together with an indication of the validity and integrity of the navigation information.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="bd9be350-bd45-420f-84b8-da7c35d3fcf5"
            ReqIFLongName="Target Cooperative Information Availability" ReqIFName="OA-N-04"
            ReqIFText="&lt;p>The Target Spacecraft needs its relevant cooperative information, including its state, operational status, docking interface characteristics and approach corridor information, to be made available to and considered by the Visiting Vehicle during RPOD operations.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="f05a3482-ce78-40b9-b076-288328321fde"
            ReqIFLongName="RPOD Phase Progression Control" ReqIFName="OA-N-05" ReqIFText="&lt;p>Mission Control needs each transition between RPOD operational phases to occur only when the applicable entry conditions and safety criteria have been satisfied.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="8325ee0d-5147-46a3-a36d-c7bebde439c5"
            ReqIFLongName="Mission Control Operational Authority" ReqIFName="OA-N-06"
            ReqIFText="&lt;p>Mission Control needs to retain the authority to hold, resume or abort RPOD operations and to authorize the execution of applicable maneuvers throughout the mission.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="eba59f88-1459-4308-8ba6-01eb6737eb89"
            ReqIFLongName="Off-Nominal Response and Safe Recovery" ReqIFName="OA-N-07"
            ReqIFText="&lt;p>Mission Control needs the Visiting Vehicle to detect and respond to off-nominal conditions by executing appropriate contingency actions, including abort, retreat, collision avoidance or safe-hold operations, as applicable, to recover or maintain a safe operational condition.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="a9401790-76a0-4a5c-8fd6-cd709ff36530"
            ReqIFLongName="Autonomous Safety During Communication Loss" ReqIFName="OA-N-08"
            ReqIFText="&lt;p>Mission Control needs the Visiting Vehicle to maintain a safe operational condition autonomously when communication with Mission Control is lost, without relying on the reception of additional ground directives.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="314eb47a-db63-4643-8f82-23e35a4501e7"
            ReqIFLongName="Mission Status and Anomaly Reporting" ReqIFName="OA-N-09"
            ReqIFText="&lt;p>Mission Control needs to receive timely and relevant information regarding the Visiting Vehicle&amp;#39;s operational status, navigation and GNC performance, maneuver execution and detected off-nominal conditions throughout RPOD operations.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="c12edd19-a926-41aa-9fb1-0e9f5e9bd155"
            ReqIFLongName="Docking Interface Acquisition Conditions" ReqIFName="OA-N-10"
            ReqIFText="&lt;p>Mission Control needs the Visiting Vehicle to reach and engage the Target Spacecraft&amp;#39;s docking interface under the required relative position, velocity, attitude and alignment conditions established for successful docking.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="d785204c-0c0e-4c2d-b714-26a074f43e29"
            ReqIFLongName="Target Spacecraft Protection" ReqIFName="OA-N-11" ReqIFText="&lt;p>The Target Spacecraft needs protection from hazardous approach behavior by the Visiting Vehicle, including unauthorized entry into its Keep-Out Sphere and approach trajectories that could result in unintended contact or collision.&lt;/p>&#xA;"/>
        <ownedRequirements xsi:type="Requirements:Requirement" id="988010d5-5186-4880-8860-27c7cea9b643"
            ReqIFLongName="Mission Communication and Command Exchange" ReqIFName="OA-N-12"
            ReqIFText="&lt;p>Mission Control needs to exchange operational commands, directives and vehicle telemetry with the Visiting Vehicle through the available communication infrastructure to support the monitoring, coordination and control of RPOD operations.&lt;/p>&#xA;"/>
      </ownedExtensions>
      <ownedExtensions xsi:type="CapellaRequirements:CapellaTypesFolder" id="aecdfd27-5ac1-4c5d-af08-dd8816b7f12a"
