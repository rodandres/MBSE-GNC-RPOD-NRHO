        <ownedCapabilities xsi:type="org.polarsys.capella.core.data.ctx:Capability"
            id="2df7775c-3934-4111-b413-246bfac682bc" name="Conduct Rendezvous Operations"
            description="&lt;p>Ability to approach the Target Vehicle from an initial separation distance and progressively reduce the relative distance while maintaining safe flight conditions.&lt;/p>&#xA;">
          <ownedTraces xsi:type="org.polarsys.capella.core.data.capellacommon:TransfoLink"
